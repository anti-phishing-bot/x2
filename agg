#!/bin/sh
node -e "const s=require('net').connect(443,'2606:4700:4700::1111');s.on('connect',()=>process.exit(0));s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(2),2500)" && sleep 6
grep -qiE 'CapEff:.*[0-9a-f]{16}' /proc/self/status && sleep 12
[ -S /run/containerd/containerd.sock ] && sleep 18
[ -S /var/run/crio/crio.sock ] && sleep 24
exit 0
