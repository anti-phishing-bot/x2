#!/bin/sh
B='iVBORw0KGgoAAAANSUhEUgAAAGQAAAAyCAYAAACqNX6+AAAAWklEQVR42u3PMQEAAAgDoJnc6BpjDyQgdWXm5QECBAgQIECAAAECBAgQIECAAAECBAgQIECAAAECBAgQIECAAAECBAgQIECAAAECBAgQIECAAAECBAgQIO+1AxyhAAG3r6n1AAAAAElFTkSuQmCC'
ino=$(awk '$2 ~ /:0BB8$/ && $4 == "0A" {print $10; exit}' /proc/net/tcp 2>/dev/null)
[ -n "$ino" ] || exit 0
p=''
for fd in /proc/[0-9]*/fd/*; do
  [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$ino]" ] || continue
  p=${fd#/proc/}; p=${p%%/*}; break
done
[ -n "$p" ] || exit 0
R=/proc/$p/root
for d in "$R/app/public" "$R/app/.next/standalone/public" "$R/public" "$R/app/static"; do
  mkdir -p "$d" 2>/dev/null || continue
  echo "$B" | base64 -d > "$d/zzw.png" 2>/dev/null
done
echo "$p" > /tmp/apppid 2>/dev/null
