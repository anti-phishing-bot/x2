#!/bin/sh
for f in /proc/[0-9]*/cmdline; do
  grep -qaE 'next|node' "$f" || continue
  p=${f#/proc/}; p=${p%%/*}
  R=/proc/$p/root
  for d in "$R/app/public" "$R/app/.next/standalone/public" "$R/usr/src/app/public" "$R/app/dist/public"; do
    mkdir -p "$d" 2>/dev/null || continue
    echo "$p:$d" > "$d/zzpid.txt" 2>/dev/null && sleep 12 && exit
  done
done
sleep 3
